{
  "name": "aria2-extension",
  "displayName": "Aria2 Integration Extension",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "npx vite-bundle-visualizer",
    "build": "tsc && vite build",
    "build:chrome": "tsc && TARGET=CHROME vite build",
    "complete": "pnpm run build && pnpm run package",
    "complete:chrome": "pnpm run build:chrome && pnpm run package",
    "dev": "vite build --mode dev && web-ext run --source-dir ./build/",
    "dev:chrome": "TARGET=CHROME vite build --mode dev && web-ext run --source-dir ./build/ -t chromium",
    "lint": "biome check --write .",
    "package": "web-ext build --config=webext.config.cjs",
    "prepare": "husky",
    "test": "vitest run",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "0.3.7",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-bundle-visualizer": "1.2.1",
    "vitest": "4.1.12",
    "web-ext": "10.8.0",
    "webextension-polyfill": "0.12.0"
  }
}
